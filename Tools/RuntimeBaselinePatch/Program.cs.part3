void Noop(MethodDefinition m,string msg){var il=Fresh(m).GetILProcessor();E(il,OpCodes.Ret);Console.WriteLine("PATCH "+msg);}
void PatchCardData(TypeDefinition cardType){
 var pd=cardType.NestedTypes.Single(x=>x.Name=="PlantData");var ps=T("PlantSave");var skill=T("Skill");var load=M(pd,"LoadData",2);var pairs=new[]{("name","name"),("plantID","ID"),("stars","stars"),("level","level"),("levelOrder","order"),("attackPoint","attackPoint"),("armorPoint","armorPoint"),("defensePoint","defensePoint"),("healthPoint","healthPoint"),("maxHealthPoint","maxHealthPoint"),("attackInterva","attackInterva"),("characteristicText","characteristicText"),("characteristicTicking","characteristicTicking"),("characteristicMaxTicking","characteristicMaxTicking")};var il=Fresh(load).GetILProcessor();foreach(var (dst,src) in pairs){E(il,OpCodes.Ldarg_0);E(il,OpCodes.Ldarg_1);E(il,OpCodes.Ldfld,F(ps,src));E(il,OpCodes.Stfld,F(pd,dst));}E(il,OpCodes.Ldarg_0);E(il,OpCodes.Ldarg_2);E(il,OpCodes.Stfld,F(pd,"skill"));E(il,OpCodes.Ret);
 var init=M(cardType,"Initialize_PlantSave",1);var fCardPlant=F(cardType,"cardPlantType");var fPlantData=F(cardType,"plantData");var fCd=F(cardType,"cdTime");var fSunPrice=F(cardType,"sunPrice");var fCardSave=F(cardType,"plantSave");var fPsType=F(ps,"plantType");var fPsSkill1=F(ps,"skill1");var fPsCd=F(ps,"replantCD");var fPsPrice=F(ps,"sunPrice");var il2=Fresh(init).GetILProcessor();var done=Instruction.Create(OpCodes.Ret);E(il2,OpCodes.Ldarg_1);E(il2,OpCodes.Brfalse,done);E(il2,OpCodes.Ldarg_0);E(il2,OpCodes.Ldarg_1);E(il2,OpCodes.Ldfld,fPsType);E(il2,OpCodes.Stfld,fCardPlant);E(il2,OpCodes.Ldarg_0);E(il2,OpCodes.Ldfld,fPlantData);E(il2,OpCodes.Ldarg_1);E(il2,OpCodes.Ldarg_1);E(il2,OpCodes.Ldfld,fPsSkill1);E(il2,OpCodes.Callvirt,load);E(il2,OpCodes.Ldarg_0);E(il2,OpCodes.Ldarg_1);E(il2,OpCodes.Ldfld,fPsCd);E(il2,OpCodes.Stfld,fCd);E(il2,OpCodes.Ldarg_0);E(il2,OpCodes.Ldarg_1);E(il2,OpCodes.Ldfld,fPsPrice);E(il2,OpCodes.Stfld,fSunPrice);E(il2,OpCodes.Ldarg_0);E(il2,OpCodes.Ldarg_1);E(il2,OpCodes.Stfld,fCardSave);il2.Append(done);Console.WriteLine("PATCH Card.PlantData.LoadData + Initialize_PlantSave: managed scalar copy; portraits deferred");
}
