 E(il,OpCodes.Call,cameraGet);E(il,OpCodes.Stloc,cv);E(il,OpCodes.Ldloc,cv);E(il,OpCodes.Brfalse,noCam);E(il,OpCodes.Ldloc,cv);E(il,OpCodes.Ldloc,mv);E(il,OpCodes.Ldfld,fMapCamera);E(il,OpCodes.Callvirt,cameraSet);il.Append(noCam);
