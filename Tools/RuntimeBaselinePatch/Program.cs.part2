  var tt=All(verify.Types).Single(t=>t.Name==s.Item1||t.FullName==s.Item1);var mm=tt.Methods.Single(m=>m.Name==s.Item2&&m.Parameters.Count==s.Item3);if(!mm.HasBody)throw new Exception($"No body {s}");Console.WriteLine($"VERIFY {s.Item1}.{s.Item2}: {mm.Body.Instructions.Count} IL");
 }
}
Console.WriteLine($"WROTE {output} ({new FileInfo(output).Length} bytes)"); return 0;

void PatchEnumLoader(MethodDefinition m,TypeDefinition item,FieldDefinition listField,TypeDefinition enumType,GenericInstanceMethod load,string folder){
 var list=(GenericInstanceType)listField.FieldType;var clear=ListMethod(list,"Clear",module.TypeSystem.Void);var add=ListMethod(list,"Add",module.TypeSystem.Void,item);var b=Fresh(m,true);var il=b.GetILProcessor();var path=new VariableDefinition(module.TypeSystem.String);var obj=new VariableDefinition(item);b.Variables.Add(path);b.Variables.Add(obj);
 E(il,OpCodes.Ldsfld,listField);E(il,OpCodes.Callvirt,clear);
 foreach(var ef in enumType.Fields.Where(f=>f.IsStatic&&f.HasConstant&&Convert.ToInt32(f.Constant)>=0).OrderBy(f=>Convert.ToInt32(f.Constant))){var skip=Instruction.Create(OpCodes.Nop);E(il,OpCodes.Ldstr,"prefabs");E(il,OpCodes.Ldstr,folder);E(il,OpCodes.Call,combine2);E(il,OpCodes.Ldstr,ef.Name);E(il,OpCodes.Call,combine2);E(il,OpCodes.Stloc,path);E(il,OpCodes.Ldloc,path);E(il,OpCodes.Call,load);E(il,OpCodes.Stloc,obj);E(il,OpCodes.Ldloc,obj);E(il,OpCodes.Brfalse,skip);E(il,OpCodes.Ldsfld,listField);E(il,OpCodes.Ldloc,obj);E(il,OpCodes.Callvirt,add);il.Append(skip);}
 E(il,OpCodes.Ldsfld,listField);E(il,OpCodes.Ret);Console.WriteLine($"PATCH ResourceManager.{m.Name}: explicit {folder} enum-prefab load");
}
