using Mono.Cecil;
using Mono.Cecil.Cil;
using System;
using System.Collections.Generic;
using System.IO;
using System.Linq;
using System.Text.RegularExpressions;

if(args.Length!=2){Console.Error.WriteLine("Usage: GodsPVZ.Stage8Patch <input.dll> <output.dll>");return 2;}
var input=Path.GetFullPath(args[0]); var output=Path.GetFullPath(args[1]);
using var module=ModuleDefinition.ReadModule(input,new ReaderParameters{InMemory=true,ReadSymbols=false});
IEnumerable<TypeDefinition> All(IEnumerable<TypeDefinition> roots){foreach(var t in roots){yield return t;foreach(var n in All(t.NestedTypes))yield return n;}}
TypeDefinition T(string n)=>All(module.Types).Single(x=>x.Name==n||x.FullName==n);
FieldDefinition F(TypeDefinition t,string n)=>t.Fields.Single(x=>x.Name==n);
MethodDefinition M(TypeDefinition t,string n,int pc){var q=t.Methods.Where(x=>x.Name==n&&x.Parameters.Count==pc).ToList();return q.Count==1?q[0]:throw new Exception($"Expected one {t.FullName}.{n}/{pc}, got {q.Count}");}
MethodBody Fresh(MethodDefinition m,bool init=false){var b=new MethodBody(m){InitLocals=init,MaxStackSize=32};m.Body=b;return b;}
void E(ILProcessor il,OpCode op,object? v=null){Instruction x=v switch{null=>Instruction.Create(op),string s=>Instruction.Create(op,s),int i=>Instruction.Create(op,i),float f=>Instruction.Create(op,f),MethodReference mr=>Instruction.Create(op,mr),FieldReference fr=>Instruction.Create(op,fr),TypeReference tr=>Instruction.Create(op,tr),ParameterDefinition pd=>Instruction.Create(op,pd),VariableDefinition vd=>Instruction.Create(op,vd),Instruction ins=>Instruction.Create(op,ins),_=>throw new NotSupportedException(v.GetType().FullName)};il.Append(x);}
MethodReference ListMethod(GenericInstanceType list,string name,TypeReference ret,params TypeReference[] ps){var mr=new MethodReference(name,ret,list){HasThis=true};foreach(var p in ps)mr.Parameters.Add(new ParameterDefinition(p));return mr;}
MethodReference FindCall(MethodDefinition m,string decl,string name,int pc)=>m.Body.Instructions.Select(i=>i.Operand).OfType<MethodReference>().First(x=>x.DeclaringType.FullName.Contains(decl)&&x.Name==name&&x.Parameters.Count==pc);
FieldReference FindFieldRef(MethodDefinition m,string decl,string name)=>m.Body.Instructions.Select(i=>i.Operand).OfType<FieldReference>().First(x=>x.DeclaringType.FullName==decl&&x.Name==name);

var adv=T("AdventureScreen"); var advButton=T("AdventureMenu_ModeButton"); var mainUI=T("MainUIController"); var savesMgr=T("SavesManager"); var save=T("Save");
var boardConfig=T("BoardConfig"); var map=T("Map"); var mouse=T("MouseManager"); var board=T("Board");
var skillData=T("SkillData"); var skill=T("Skill"); var skillDataList=T("SkillDataList"); var skillMgr=T("SkillManager");

PatchAdventureAwake();
PatchGrid();
PatchMouseUpdate();
PatchSkillDataCtor();
PatchSkillDataFixes();
PatchSkillDataClone();
PatchSkillDataListCtorFixes();
PatchSkillManagerUpdate();
PatchSkillManagerCctor();

Directory.CreateDirectory(Path.GetDirectoryName(output)!); module.Write(output,new WriterParameters{WriteSymbols=false});
using(var verify=ModuleDefinition.ReadModule(output,new ReaderParameters{InMemory=true,ReadSymbols=false})){
 var specs=new[]{("AdventureScreen","Awake",0),("BoardConfig","GetGridX",2),("BoardConfig","GetGridY",2),("MouseManager","Update",0),("SkillData",".ctor",1),("SkillData","Fixes",0),("SkillData","Clone",2),("SkillDataList",".ctor",0),("SkillDataList","Fixes",0),("SkillManager","UpdataSkill",3),("SkillManager",".cctor",0)};
 foreach(var s in specs){var tt=All(verify.Types).Single(t=>t.Name==s.Item1||t.FullName==s.Item1);var mm=tt.Methods.Single(m=>m.Name==s.Item2&&m.Parameters.Count==s.Item3);if(!mm.HasBody||mm.Body.Instructions.Count<2)throw new Exception($"Bad body {s}");Console.WriteLine($"VERIFY {s.Item1}.{s.Item2}: {mm.Body.Instructions.Count} IL");}
}
Console.WriteLine($"WROTE {output} ({new FileInfo(output).Length} bytes)");return 0;

void PatchAdventureAwake(){
 var m=M(adv,"Awake",0); var fButtons=F(adv,"modeButtons"); var fMain=F(adv,"mainUIController"); var fHard=F(adv,"AdventureHardScreen"); var fRescue=F(adv,"RescueScreem"); var fSaves=F(mainUI,"savesManager"); var fPlayer=F(savesMgr,"playerSave");
 var list=(GenericInstanceType)fButtons.FieldType; var count=ListMethod(list,"get_Count",module.TypeSystem.Int32); var item=ListMethod(list,"get_Item",advButton,module.TypeSystem.Int32); var test=M(advButton,"TestLocked",1);
 var setActive=FindCall(m,"UnityEngine.GameObject","SetActive",1); var getGameObject=m.Body.Instructions.Select(i=>i.Operand).OfType<MethodReference>().First(x=>x.Name=="get_gameObject"&&x.DeclaringType.FullName.Contains("Component"));
 var b=Fresh(m,true);var il=b.GetILProcessor();var i=new VariableDefinition(module.TypeSystem.Int32);var ps=new VariableDefinition(save);var btn=new VariableDefinition(advButton);b.Variables.Add(i);b.Variables.Add(ps);b.Variables.Add(btn);
 var noSave=Instruction.Create(OpCodes.Nop); var loopCheck=Instruction.Create(OpCodes.Nop); var loopBody=Instruction.Create(OpCodes.Nop); var next=Instruction.Create(OpCodes.Nop); var afterLoop=Instruction.Create(OpCodes.Nop); var skipHard=Instruction.Create(OpCodes.Nop); var skipRescue=Instruction.Create(OpCodes.Nop);
 E(il,OpCodes.Ldarg_0);E(il,OpCodes.Ldfld,fMain);E(il,OpCodes.Brfalse,noSave);E(il,OpCodes.Ldarg_0);E(il,OpCodes.Ldfld,fMain);E(il,OpCodes.Ldfld,fSaves);E(il,OpCodes.Brfalse,noSave);E(il,OpCodes.Ldarg_0);E(il,OpCodes.Ldfld,fMain);E(il,OpCodes.Ldfld,fSaves);E(il,OpCodes.Ldfld,fPlayer);E(il,OpCodes.Stloc,ps);E(il,OpCodes.Br,loopCheck);il.Append(noSave);E(il,OpCodes.Ldnull);E(il,OpCodes.Stloc,ps);
 E(il,OpCodes.Ldc_I4_0);E(il,OpCodes.Stloc,i);il.Append(loopCheck);E(il,OpCodes.Ldarg_0);E(il,OpCodes.Ldfld,fButtons);E(il,OpCodes.Brfalse,afterLoop);E(il,OpCodes.Ldloc,i);E(il,OpCodes.Ldarg_0);E(il,OpCodes.Ldfld,fButtons);E(il,OpCodes.Callvirt,count);E(il,OpCodes.Bge,afterLoop);il.Append(loopBody);E(il,OpCodes.Ldarg_0);E(il,OpCodes.Ldfld,fButtons);E(il,OpCodes.Ldloc,i);E(il,OpCodes.Callvirt,item);E(il,OpCodes.Stloc,btn);E(il,OpCodes.Ldloc,btn);E(il,OpCodes.Brfalse,next);E(il,OpCodes.Ldloc,ps);E(il,OpCodes.Brfalse,next);E(il,OpCodes.Ldloc,btn);E(il,OpCodes.Ldloc,ps);E(il,OpCodes.Callvirt,test);il.Append(next);E(il,OpCodes.Ldloc,i);E(il,OpCodes.Ldc_I4_1);E(il,OpCodes.Add);E(il,OpCodes.Stloc,i);E(il,OpCodes.Br,loopCheck);
 il.Append(afterLoop);E(il,OpCodes.Ldarg_0);E(il,OpCodes.Ldfld,fHard);E(il,OpCodes.Brfalse,skipHard);E(il,OpCodes.Ldarg_0);E(il,OpCodes.Ldfld,fHard);E(il,OpCodes.Callvirt,getGameObject);E(il,OpCodes.Ldc_I4_0);E(il,OpCodes.Callvirt,setActive);il.Append(skipHard);E(il,OpCodes.Ldarg_0);E(il,OpCodes.Ldfld,fRescue);E(il,OpCodes.Brfalse,skipRescue);E(il,OpCodes.Ldarg_0);E(il,OpCodes.Ldfld,fRescue);E(il,OpCodes.Callvirt,getGameObject);E(il,OpCodes.Ldc_I4_0);E(il,OpCodes.Callvirt,setActive);il.Append(skipRescue);E(il,OpCodes.Ret);
 Console.WriteLine("PATCH AdventureScreen.Awake: managed mode-button iteration + sub-screen hide");
}

void PatchGrid(){
 var fx=F(boardConfig,"map"); var gx=M(map,"GetMapX",0);var gy=M(map,"GetMapY",0);
 foreach(var tuple in new[]{(M(boardConfig,"GetGridX",2),true),(M(boardConfig,"GetGridY",2),false)}){
  var m=tuple.Item1;var floor=FindCall(m,"System.MathF","Floor",1);var b=Fresh(m,true);var il=b.GetILProcessor();var size=new VariableDefinition(module.TypeSystem.Int32);b.Variables.Add(size);var ret0=Instruction.Create(OpCodes.Ldc_I4_0);
  E(il,OpCodes.Ldarg_0);E(il,OpCodes.Ldfld,fx);E(il,OpCodes.Brfalse,ret0);E(il,OpCodes.Ldarg_0);E(il,OpCodes.Ldfld,fx);E(il,OpCodes.Callvirt,tuple.Item2?gx:gy);E(il,OpCodes.Stloc,size);
  if(tuple.Item2){E(il,OpCodes.Ldarg_1);E(il,OpCodes.Ldloc,size);E(il,OpCodes.Ldc_I4_2);E(il,OpCodes.Div);E(il,OpCodes.Conv_R4);E(il,OpCodes.Ldc_R4,114f);E(il,OpCodes.Mul);E(il,OpCodes.Add);E(il,OpCodes.Ldc_R4,114f);E(il,OpCodes.Div);E(il,OpCodes.Call,floor);E(il,OpCodes.Conv_I4);E(il,OpCodes.Ret);} else {E(il,OpCodes.Ldarg_2);E(il,OpCodes.Ldloc,size);E(il,OpCodes.Ldc_I4_2);E(il,OpCodes.Div);E(il,OpCodes.Ldc_I4_1);E(il,OpCodes.Sub);E(il,OpCodes.Conv_R4);E(il,OpCodes.Ldc_R4,134f);E(il,OpCodes.Mul);E(il,OpCodes.Sub);E(il,OpCodes.Ldc_R4,134f);E(il,OpCodes.Div);E(il,OpCodes.Call,floor);E(il,OpCodes.Conv_I4);E(il,OpCodes.Neg);E(il,OpCodes.Ret);}
  il.Append(ret0);E(il,OpCodes.Ret);
 }
 Console.WriteLine("PATCH BoardConfig.GetGridX/GetGridY: deterministic grid math");
}

void PatchMouseUpdate(){
 var m=M(mouse,"Update",0); var fBoard=F(mouse,"board"); var fOnBoard=F(mouse,"onBoard"); var fWX=F(mouse,"mouseWorldPosition"); var fX=F(mouse,"fX"); var fY=F(mouse,"fY"); var fGX=F(mouse,"GridX"); var fGY=F(mouse,"GridY"); var fBC=F(board,"boardConfig"); var fFailed=F(board,"isFailed");
 var getMain=FindCall(m,"UnityEngine.Camera","get_main",0); var getMouse=FindCall(m,"UnityEngine.Input","get_mousePosition",0); var screen=FindCall(m,"UnityEngine.Camera","ScreenToWorldPoint",1); var vx=new FieldReference("x",module.TypeSystem.Single,getMouse.ReturnType); var vy=new FieldReference("y",module.TypeSystem.Single,getMouse.ReturnType);
 var getGridX=M(boardConfig,"GetGridX",2); var getGridY=M(boardConfig,"GetGridY",2); var preview=M(mouse,"Update_PrefabOnField",0);
 var cameraType=getMain.ReturnType; var vectorType=getMouse.ReturnType;var b=Fresh(m,true);var il=b.GetILProcessor();var cam=new VariableDefinition(cameraType); var world=new VariableDefinition(vectorType);b.Variables.Add(cam);b.Variables.Add(world);var ret=Instruction.Create(OpCodes.Ret); var noBoard=Instruction.Create(OpCodes.Nop);
 E(il,OpCodes.Call,getMain);E(il,OpCodes.Stloc,cam);E(il,OpCodes.Ldloc,cam);E(il,OpCodes.Brfalse,ret);E(il,OpCodes.Ldloc,cam);E(il,OpCodes.Call,getMouse);E(il,OpCodes.Callvirt,screen);E(il,OpCodes.Stloc,world);E(il,OpCodes.Ldarg_0);E(il,OpCodes.Ldloc,world);E(il,OpCodes.Stfld,fWX);E(il,OpCodes.Ldarg_0);E(il,OpCodes.Ldloca,world);E(il,OpCodes.Ldfld,vx);E(il,OpCodes.Stfld,fX);E(il,OpCodes.Ldarg_0);E(il,OpCodes.Ldloca,world);E(il,OpCodes.Ldfld,vy);E(il,OpCodes.Stfld,fY);
 E(il,OpCodes.Ldarg_0);E(il,OpCodes.Ldfld,fOnBoard);E(il,OpCodes.Brfalse,noBoard);E(il,OpCodes.Ldarg_0);E(il,OpCodes.Ldfld,fBoard);E(il,OpCodes.Brfalse,noBoard);E(il,OpCodes.Ldarg_0);E(il,OpCodes.Ldfld,fBoard);E(il,OpCodes.Ldfld,fFailed);E(il,OpCodes.Brtrue,noBoard);E(il,OpCodes.Ldarg_0);E(il,OpCodes.Ldfld,fBoard);E(il,OpCodes.Ldfld,fBC);E(il,OpCodes.Brfalse,noBoard);
 E(il,OpCodes.Ldarg_0);E(il,OpCodes.Ldarg_0);E(il,OpCodes.Ldfld,fBoard);E(il,OpCodes.Ldfld,fBC);E(il,OpCodes.Ldarg_0);E(il,OpCodes.Ldfld,fX);E(il,OpCodes.Ldarg_0);E(il,OpCodes.Ldfld,fY);E(il,OpCodes.Callvirt,getGridX);E(il,OpCodes.Stfld,fGX);E(il,OpCodes.Ldarg_0);E(il,OpCodes.Ldarg_0);E(il,OpCodes.Ldfld,fBoard);E(il,OpCodes.Ldfld,fBC);E(il,OpCodes.Ldarg_0);E(il,OpCodes.Ldfld,fX);E(il,OpCodes.Ldarg_0);E(il,OpCodes.Ldfld,fY);E(il,OpCodes.Callvirt,getGridY);E(il,OpCodes.Stfld,fGY);E(il,OpCodes.Ldarg_0);E(il,OpCodes.Call,preview);il.Append(noBoard);il.Append(ret);
 Console.WriteLine("PATCH MouseManager.Update: stable pointer/grid tracking; click dispatcher deferred");
}
